{
  "name": "hollow-studio-bot",
  "version": "1.0.0",
  "description": "Official Hollow Studio Discord Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "db:init": "tsx src/database/init.ts",
    "dashboard:api": "tsx watch src/dashboard/server.ts",
    "dashboard:web": "vite --config dashboard/vite.config.ts --host 0.0.0.0",
    "dashboard": "concurrently -k \"npm:dashboard:api\" \"npm:dashboard:web\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
